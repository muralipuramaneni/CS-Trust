# Local Docker Postgres (docker compose in this folder):
# DATABASE_URL=postgresql+psycopg2://cstrust:cstrust@127.0.0.1:5433/cstrust

# Shared Supabase (ask lead for credentials; URL-encode special chars in password):
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
ALGORITHM=HS256
